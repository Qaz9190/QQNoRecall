<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>title</key>
    <string>QQ 防撤回</string>
    <key>items</key>
    <array>
        <dict>
            <key>cell</key>
            <string>PSGroupCell</string>
            <key>label</key>
            <string>QQNoRecall v1.0.0</string>
            <key>footerText</key>
            <string>拦截 QQ 的消息撤回与闪图(阅后即焚)销毁。开关即时生效，无需重启。</string>
        </dict>
        <dict>
            <key>cell</key>
            <string>PSSwitchCell</string>
            <key>label</key>
            <string>消息防撤回</string>
            <key>defaults</key>
            <string>com.qaz9190.qqnorecall</string>
            <key>key</key>
            <string>kEnableMessageRecall</string>
            <key>default</key>
            <true/>
            <key>PostNotification</key>
            <string>com.qaz9190.qqnorecall/prefsChanged</string>
        </dict>
        <dict>
            <key>cell</key>
            <string>PSSwitchCell</string>
            <key>label</key>
            <string>闪图防撤回</string>
            <key>defaults</key>
            <string>com.qaz9190.qqnorecall</string>
            <key>key</key>
            <string>kEnableFlashPic</string>
            <key>default</key>
            <true/>
            <key>PostNotification</key>
            <string>com.qaz9190.qqnorecall/prefsChanged</string>
        </dict>
        <dict>
            <key>cell</key>
            <string>PSSwitchCell</string>
            <key>label</key>
            <string>拦截时顶部提示</string>
            <key>defaults</key>
            <string>com.qaz9190.qqnorecall</string>
            <key>key</key>
            <string>kShowToast</string>
            <key>default</key>
            <false/>
            <key>PostNotification</key>
            <string>com.qaz9190.qqnorecall/prefsChanged</string>
        </dict>
    </array>
</dict>
</plist>
